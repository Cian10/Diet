{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "W3C DTCG Design Tokens for Atelier Nutrition Desk (reconciled with Phase 1 frozen spec §2.1). Light mode values are canonical in `color`; Dark mode values are provided in both `$extensions.dark` and `colorDark`.",
  "color": {
    "canvas": {
      "$value": "#F1F1EC",
      "$type": "color",
      "$description": "Outer form backdrop / grouped sheet canvas (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#101110" } }
    },
    "paper": {
      "$value": "#F6F6F3",
      "$type": "color",
      "$description": "Primary Stone Paper workspace background (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#131413" } }
    },
    "sidebar": {
      "$value": "#EFEFE9",
      "$type": "color",
      "$description": "Sidebar fallback surface; macOS prefers native .listStyle(.sidebar) vibrancy (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#181918" } }
    },
    "surface": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Elevated dashboard stage, inputs, and sheets (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#1C1E1C" } }
    },
    "surfaceMuted": {
      "$value": "#ECECE7",
      "$type": "color",
      "$description": "Progress bar tracks, segmented slots, hover row fill (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#252825" } }
    },
    "ink": {
      "$value": "#181A18",
      "$type": "color",
      "$description": "Primary headings, hero numbers, meal names (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#F2F2EE" } }
    },
    "inkSecondary": {
      "$value": "#5B605C",
      "$type": "color",
      "$description": "Secondary body text and units (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#A2A8A3" } }
    },
    "inkTertiary": {
      "$value": "#6E7470",
      "$type": "color",
      "$description": "Auxiliary labels >= 11pt only; prefer inkSecondary on paper (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#868D88" } }
    },
    "border": {
      "$value": "#E2E2DC",
      "$type": "color",
      "$description": "Strokes and borders (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#2D302D" } }
    },
    "hairline": {
      "$value": "#E2E2DC",
      "$type": "color",
      "$description": "0.5pt hairline divider for borderless lists and group headers (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#2D302D" } }
    },
    "primary": {
      "$value": "#1F5E43",
      "$type": "color",
      "$description": "Deep Pine primary action, progress fill, active focus (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#5CC192" } }
    },
    "primaryDeep": {
      "$value": "#174833",
      "$type": "color",
      "$description": "Hover / high-emphasis primary button background (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#8ADBB3" } }
    },
    "primaryText": {
      "$value": "#1D573E",
      "$type": "color",
      "$description": "Status text on light surfaces, text buttons, active sidebar tint (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#7AD4A8" } }
    },
    "onPrimary": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Text/icons on primary (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#0D1F17" } }
    },
    "onPrimaryDeep": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Text/icons on primaryDeep (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#0F241B" } }
    },
    "primarySoft": {
      "$value": "#E4EFE9",
      "$type": "color",
      "$description": "Subtle active pill background (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#1E3329" } }
    },
    "primaryLine": {
      "$value": "#C7DDD1",
      "$type": "color",
      "$description": "Subtle active pill border (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#2E4B3D" } }
    },
    "warning": {
      "$value": "#B86B1A",
      "$type": "color",
      "$description": "Estimated / unknown nutrition icon, hatched tail, badge accent (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#F0B25F" } }
    },
    "warningSoft": {
      "$value": "#FBF1E3",
      "$type": "color",
      "$description": "Estimated / unknown nutrition subtle container fill (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#362A1B" } }
    },
    "danger": {
      "$value": "#B33A32",
      "$type": "color",
      "$description": "Destructive actions and errors only; never calorie over-target (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#F08078" } }
    },
    "dangerSoft": {
      "$value": "#FAE7E5",
      "$type": "color",
      "$description": "Error container fill (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#38201E" } }
    },
    "macroProtein": {
      "$value": "#2A6F97",
      "$type": "color",
      "$description": "Protein signal bar fill (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#64B5E5" } }
    },
    "macroProteinSoft": {
      "$value": "#E6F0F6",
      "$type": "color",
      "$description": "Protein soft surface tint (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#1B2F3B" } }
    },
    "macroCarbs": {
      "$value": "#C47D2B",
      "$type": "color",
      "$description": "Carbohydrate signal bar fill (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#E5A952" } }
    },
    "macroCarbsSoft": {
      "$value": "#F8EFE3",
      "$type": "color",
      "$description": "Carbohydrate soft surface tint (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#352919" } }
    },
    "macroFat": {
      "$value": "#8A5A7E",
      "$type": "color",
      "$description": "Fat signal bar fill (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#C68FB8" } }
    },
    "macroFatSoft": {
      "$value": "#F2EBF0",
      "$type": "color",
      "$description": "Fat soft surface tint (Light)",
      "$extensions": { "com.atelier-nutrition-desk": { "dark": "#31232E" } }
    }
  },
  "colorDark": {
    "canvas": { "$value": "#101110", "$type": "color" },
    "paper": { "$value": "#131413", "$type": "color" },
    "sidebar": { "$value": "#181918", "$type": "color" },
    "surface": { "$value": "#1C1E1C", "$type": "color" },
    "surfaceMuted": { "$value": "#252825", "$type": "color" },
    "ink": { "$value": "#F2F2EE", "$type": "color" },
    "inkSecondary": { "$value": "#A2A8A3", "$type": "color" },
    "inkTertiary": { "$value": "#868D88", "$type": "color" },
    "border": { "$value": "#2D302D", "$type": "color" },
    "hairline": { "$value": "#2D302D", "$type": "color" },
    "primary": { "$value": "#5CC192", "$type": "color" },
    "primaryDeep": { "$value": "#8ADBB3", "$type": "color" },
    "primaryText": { "$value": "#7AD4A8", "$type": "color" },
    "onPrimary": { "$value": "#0D1F17", "$type": "color" },
    "onPrimaryDeep": { "$value": "#0F241B", "$type": "color" },
    "primarySoft": { "$value": "#1E3329", "$type": "color" },
    "primaryLine": { "$value": "#2E4B3D", "$type": "color" },
    "warning": { "$value": "#F0B25F", "$type": "color" },
    "warningSoft": { "$value": "#362A1B", "$type": "color" },
    "danger": { "$value": "#F08078", "$type": "color" },
    "dangerSoft": { "$value": "#38201E", "$type": "color" },
    "macroProtein": { "$value": "#64B5E5", "$type": "color" },
    "macroProteinSoft": { "$value": "#1B2F3B", "$type": "color" },
    "macroCarbs": { "$value": "#E5A952", "$type": "color" },
    "macroCarbsSoft": { "$value": "#352919", "$type": "color" },
    "macroFat": { "$value": "#C68FB8", "$type": "color" },
    "macroFatSoft": { "$value": "#31232E", "$type": "color" }
  },
  "font": {
    "heading": {
      "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Display', system-ui, sans-serif",
      "$type": "fontFamily",
      "$description": "Native macOS/iOS SF Pro Display / System sans-serif"
    },
    "body": {
      "$value": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif",
      "$type": "fontFamily",
      "$description": "Native macOS/iOS SF Pro Text / System sans-serif"
    },
    "rounded": {
      "$value": "'SF Pro Rounded', ui-rounded, -apple-system, system-ui, sans-serif",
      "$type": "fontFamily",
      "$description": "Native SF Rounded for heroMetric and subMetric with .monospacedDigit()"
    }
  },
  "dimension": {
    "pagePadding": { "$value": "28px", "$type": "dimension" },
    "compactPagePadding": { "$value": "20px", "$type": "dimension" },
    "sectionSpacing": { "$value": "24px", "$type": "dimension" },
    "itemSpacing": { "$value": "12px", "$type": "dimension" },
    "cardPadding": { "$value": "18px", "$type": "dimension" },
    "focusPadding": { "$value": "22px", "$type": "dimension" },
    "controlHeight": { "$value": "32px", "$type": "dimension" },
    "cardRadius": { "$value": "12px", "$type": "dimension" },
    "focusRadius": { "$value": "16px", "$type": "dimension" },
    "controlRadius": { "$value": "8px", "$type": "dimension" },
    "sheetRadius": { "$value": "18px", "$type": "dimension" },
    "contentWidth": { "$value": "1180px", "$type": "dimension" },
    "workbenchMaxWidth": { "$value": "1220px", "$type": "dimension" },
    "railMinWidth": { "$value": "290px", "$type": "dimension" },
    "railMaxWidth": { "$value": "350px", "$type": "dimension" },
    "twoColumnBreakpoint": { "$value": "840px", "$type": "dimension" }
  },
  "typography": {
    "heroMetric": {
      "$value": {
        "fontFamily": "{font.rounded}",
        "fontSize": "36px",
        "fontWeight": 700,
        "fontFeatureSettings": "tnum"
      },
      "$type": "typography"
    },
    "subMetric": {
      "$value": {
        "fontFamily": "{font.rounded}",
        "fontSize": "18px",
        "fontWeight": 600,
        "fontFeatureSettings": "tnum"
      },
      "$type": "typography"
    },
    "groupEyebrow": {
      "$value": {
        "fontFamily": "{font.body}",
        "fontSize": "12px",
        "fontWeight": 600
      },
      "$type": "typography"
    }
  },
  "semantic": {
    "color": {
      "primary": { "$value": "{color.primary}", "$type": "color" },
      "on-primary": { "$value": "{color.onPrimary}", "$type": "color" },
      "primary-deep": { "$value": "{color.primaryDeep}", "$type": "color" },
      "on-primary-deep": { "$value": "{color.onPrimaryDeep}", "$type": "color" },
      "primary-text": { "$value": "{color.primaryText}", "$type": "color" },
      "primary-soft": { "$value": "{color.primarySoft}", "$type": "color" },
      "primary-line": { "$value": "{color.primaryLine}", "$type": "color" },
      "background": { "$value": "{color.paper}", "$type": "color" },
      "canvas": { "$value": "{color.canvas}", "$type": "color" },
      "foreground": { "$value": "{color.ink}", "$type": "color" },
      "card": { "$value": "{color.surface}", "$type": "color" },
      "card-foreground": { "$value": "{color.ink}", "$type": "color" },
      "muted": { "$value": "{color.surfaceMuted}", "$type": "color" },
      "muted-foreground": { "$value": "{color.inkSecondary}", "$type": "color" },
      "tertiary-foreground": { "$value": "{color.inkTertiary}", "$type": "color" },
      "border": { "$value": "{color.border}", "$type": "color" },
      "hairline": { "$value": "{color.hairline}", "$type": "color" },
      "warning": { "$value": "{color.warning}", "$type": "color" },
      "warning-soft": { "$value": "{color.warningSoft}", "$type": "color" },
      "destructive": { "$value": "{color.danger}", "$type": "color" },
      "destructive-soft": { "$value": "{color.dangerSoft}", "$type": "color" },
      "macro-protein": { "$value": "{color.macroProtein}", "$type": "color" },
      "macro-protein-soft": { "$value": "{color.macroProteinSoft}", "$type": "color" },
      "macro-carbs": { "$value": "{color.macroCarbs}", "$type": "color" },
      "macro-carbs-soft": { "$value": "{color.macroCarbsSoft}", "$type": "color" },
      "macro-fat": { "$value": "{color.macroFat}", "$type": "color" },
      "macro-fat-soft": { "$value": "{color.macroFatSoft}", "$type": "color" },
      "ring": { "$value": "{color.primary}", "$type": "color" }
    },
    "font": {
      "heading": { "$value": "{font.heading}", "$type": "fontFamily" },
      "body": { "$value": "{font.body}", "$type": "fontFamily" },
      "rounded": { "$value": "{font.rounded}", "$type": "fontFamily" }
    }
  }
}
